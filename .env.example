# RAILPULSE AI Environment Configuration
# Copy this file to .env and replace placeholder values for production deployment.
# NEVER commit .env with real secrets to version control.

# Application Environment: development | production | test
RAILPULSE_ENV=development

# Cryptographic secret for signing JWT session tokens (minimum 32 random bytes recommended)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RAILPULSE_JWT_SECRET=change-this-to-a-long-random-secret-in-production

# JWT Token Expiration in minutes
RAILPULSE_JWT_EXPIRE_MINUTES=480

# Comma-separated allowed CORS origins (never use * in production)
RAILPULSE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (defaults to local SQLite file if omitted)
RAILPULSE_DB_PATH=data/railpulse.db

# Optional Upload Directory (defaults to data/uploads)
RAILPULSE_UPLOAD_DIR=data/uploads

# Optional: Enable seeded demonstration data & demo login accounts (true | false)
RAILPULSE_ENABLE_DEMO_DATA=true

# Optional: Google Gemini API Key for live Vision & RAILY LLM analysis
# Leave blank to run RAILPULSE AI in clearly labelled DEMO / Guided Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Supabase configuration (if using external Supabase persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
